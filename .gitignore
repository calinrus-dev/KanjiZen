# ==============================================================================
# KanjiZen - Enterprise-Grade Git Ignore Template
# ==============================================================================

# ─── Dart & Flutter Core ──────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
pubspec_overrides.yaml

# Build directories and binaries
build/
bin/
*.exe
*.dll
*.so
*.dylib

# Code generation (if not checked in, which is standard)
*.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart

# ─── Isar Database ────────────────────────────────────────────────────────────
*.isar
*.isar.lock

# ─── Test Coverage & Logs ─────────────────────────────────────────────────────
coverage/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/analyze_output.txt
/analyze_output_utf8.txt

# ─── Android ──────────────────────────────────────────────────────────────────
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/app/local.properties
**/android/app/key.properties
**/android/build/
**/android/app/build/
**/*.keystore
**/*.jks
**/*.apk
**/*.aab

# ─── iOS & macOS ──────────────────────────────────────────────────────────────
**/ios/.symlinks/
**/ios/Pods/
**/ios/.flutter-plugins
**/ios/.flutter-plugins-dependencies
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Helper/
**/ios/DerivedData/
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/macos/.symlinks/
**/macos/Flutter/Generated.xcconfig
**/macos/Flutter/flutter_export_environment.sh
**/macos/DerivedData/
*.xcworkspace
*.xcodeproj
*.podspec

# ─── Windows, Linux, Web ─────────────────────────────────────────────────────
**/windows/flutter/ephemeral/
**/windows/CMakeLists.txt.user
**/linux/flutter/ephemeral/
**/web/assets/
**/web/index.html.tmp

# ─── IDEs & Editors ──────────────────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# General Editor temporary files
*.swp
*~

# ─── OS Specific ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Melos & Workspace ────────────────────────────────────────────────────────
.melos_tool/
melos_*.iml
